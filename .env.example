# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SECRET_KEY=change-me
# True for local development. Set False in production.
DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# True  -> use the local db.sqlite3 file
# False -> DATABASE_URL is required
DEVELOPMENT_MODE=True
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# OpenRouter — the single inference provider for every model
# Get a key at https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SYSTEM_PROMPT=You are a helpful assistant. Answer using Markdown formatting.
# Seconds before an inference call is abandoned
# OPENROUTER_TIMEOUT=120
# Seconds the /models catalogue is cached in memory
# OPENROUTER_MODELS_CACHE_TTL=3600
# Previous turns replayed to the model when a conversation_id is supplied
# OPENROUTER_HISTORY_TURNS=10

# Optional attribution shown on https://openrouter.ai/rankings
# OPENROUTER_SITE_URL=https://chattydesk.example.com
# OPENROUTER_SITE_NAME=ChattyDesk

# ---------------------------------------------------------------------------
# Models used by the deprecated /api/v1/<vendor>_handler/ compatibility routes
# ---------------------------------------------------------------------------
# OPENROUTER_LEGACY_GPT_MODEL=openai/gpt-4o-mini
# OPENROUTER_LEGACY_GEMINI_MODEL=google/gemini-2.5-flash
# OPENROUTER_LEGACY_CLAUDE_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_LEGACY_MISTRAL_MODEL=mistralai/mistral-large
